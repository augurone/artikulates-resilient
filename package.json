{
  "name": "eslint-plugin-resilient",
  "version": "0.7.7",
  "type": "module",
  "description": "Native-JavaScript discipline and contract analysis for explicit code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augurone/artikulates-resilient.git"
  },
  "homepage": "https://github.com/augurone/artikulates-resilient#readme",
  "bugs": {
    "url": "https://github.com/augurone/artikulates-resilient/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "javascript",
    "static-analysis",
    "code-contracts",
    "functional-javascript",
    "runtime-safety",
    "destructuring",
    "defensive-programming"
  ],
  "engines": {
    "node": "22.13.0"
  },
  "exports": {
    ".": "./index.js",
    "./production": "./config/production.js",
    "./check": "./scripts/check-eslint.js",
    "./audit": "./scripts/audit-eslint-exceptions.js",
    "./agreement": "./analysis/agreement/index.js",
    "./analyzer": "./analysis/analyzer/index.js",
    "./analyzer/typescript": "./transforms/typescript/understand/source-analysis.js",
    "./eslint": "./analysis/eslint/index.js",
    "./typescript": "./transforms/typescript/index.js",
    "./typescript/config": "./config/typescript-lowering.json",
    "./standard/object": "./analysis/host/object.js",
    "./standard/array": "./analysis/host/array.js",
    "./standard/function": "./analysis/host/function.js"
  },
  "bin": {
    "resilient-check": "./scripts/check-eslint.js",
    "resilient-measure": "./scripts/measure-project.js",
    "resilient-audit": "./scripts/audit-eslint-exceptions.js",
    "resilient-lower": "./scripts/lower-typescript-project.js",
    "resilient-inspect": "./scripts/inspect-javascript.js",
    "resilient-prove": "./scripts/prove-typescript-project.js"
  },
  "files": [
    "analysis",
    "index.js",
    "integrations",
    "config/production.js",
    "scripts/check-eslint.js",
    "scripts/measure-project.js",
    "scripts/audit-eslint-exceptions.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "transforms",
    "config/typescript-lowering.json",
    "scripts/lower-typescript-project.js",
    "scripts/inspect-javascript.js",
    "scripts/prove-typescript-project.js",
    "scripts/fix-javascript-worker.js",
    "scripts/fluency-report.js"
  ],
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-plugin-import-x": "^4.18.1",
    "espree": "11.2.0",
    "globals": "17.13.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.12.0"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-plugin-n": "18.4.1"
  },
  "scripts": {
    "lint": "node scripts/lint.js",
    "lint:report": "node scripts/lint.js --report",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "check:package": "node scripts/check-package.js",
    "check": "npm run lint && npm run check:package",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release.js --check"
  }
}
