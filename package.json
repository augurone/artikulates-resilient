{
  "name": "eslint-plugin-resilient",
  "version": "0.7.1",
  "description": "Native-JavaScript discipline and contract analysis for explicit code",
  "type": "module",
  "main": "index.js",
  "bin": {
    "resilient-inspect": "scripts/inspect-stack.js"
  },
  "exports": {
    ".": "./index.js",
    "./contracts": "./rules/contracts/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augurone/artikulates-resilient.git"
  },
  "homepage": "https://github.com/augurone/artikulates-resilient#readme",
  "bugs": {
    "url": "https://github.com/augurone/artikulates-resilient/issues"
  },
  "files": [
    "index.js",
    "rules",
    "scripts/inspect-stack.js",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "javascript",
    "static-analysis",
    "code-contracts",
    "functional-javascript",
    "runtime-safety",
    "destructuring",
    "defensive-programming"
  ],
  "scripts": {
    "lint": "eslint . --ignore-pattern tests/fixtures",
    "postlint": "node scripts/report-outdated.js",
    "test": "node tests/run.js",
    "fixtures:check": "node scripts/check-fixtures.js",
    "consumer:check": "node scripts/check-consumer.js",
    "inspect:stack": "node scripts/inspect-stack.js",
    "benchmark": "node scripts/benchmark.js",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release.js --check"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "eslint": "^10.9.1"
  },
  "dependencies": {
    "eslint-plugin-import-x": "^4.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.12.0"
  },
  "license": "MIT"
}
