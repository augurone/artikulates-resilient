{
  "name": "eslint-plugin-resilient",
  "version": "0.7.5",
  "description": "Native-JavaScript discipline and contract analysis for explicit code",
  "type": "module",
  "main": "index.js",
  "bin": {
    "resilient-inspect": "scripts/inspect-stack.js",
    "resilient-measure": "scripts/measure-project.js",
    "resilient-lower": "scripts/lower-typescript-project.js",
    "resilient-prove": "scripts/prove-typescript-project.js"
  },
  "exports": {
    ".": "./index.js",
    "./contracts": "./rules/contracts/index.js",
    "./project": "./integrations/project.js",
    "./standard/object": "./rules/support/object.js",
    "./standard/array": "./rules/support/array.js",
    "./standard/function": "./rules/support/function.js",
    "./typescript": "./transforms/typescript/index.js",
    "./fp-ts-proof": "./scripts/fp-ts-proof.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augurone/artikulates-resilient.git"
  },
  "homepage": "https://github.com/augurone/artikulates-resilient#readme",
  "bugs": {
    "url": "https://github.com/augurone/artikulates-resilient/issues"
  },
  "files": [
    "index.js",
    "integrations",
    "rules",
    "transforms",
    "scripts",
    "scripts/inspect-stack.js",
    "scripts/fluency-report.js",
    "scripts/fp-ts-proof.config.js",
    "scripts/lower-typescript-project.js",
    "scripts/prove-typescript-project.js",
    "docs/README.md",
    "docs/reference",
    "docs/rules",
    "docs/guide",
    "docs/ai",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "javascript",
    "static-analysis",
    "code-contracts",
    "functional-javascript",
    "runtime-safety",
    "destructuring",
    "defensive-programming"
  ],
  "scripts": {
    "lint": "node scripts/audit-eslint-exceptions.js && DEBUG=eslint:eslint,eslint:eslint-helpers node node_modules/eslint/bin/eslint.js . --ignore-pattern tests/fixtures",
    "lint:javascript": "node scripts/audit-eslint-exceptions.js && DEBUG=eslint:eslint,eslint:eslint-helpers node node_modules/eslint/bin/eslint.js . --ignore-pattern transforms --ignore-pattern 'tests/typescript-*' --ignore-pattern tests/fixtures --ignore-pattern tests/proofs",
    "postlint": "node scripts/report-outdated.js",
    "test": "node --max-old-space-size=8192 tests/run.js",
    "test:javascript": "node tests/run.js --family javascript",
    "test:operations": "node tests/run.js --family operations",
    "proof:catalogs": "node scripts/check-proof-catalogs.js",
    "fixtures:check": "node scripts/check-fixtures.js",
    "typescript:lower": "node scripts/check-typescript-library.js",
    "typescript:fp-ts-corpus-check": "node scripts/check-fp-ts-corpus.js",
    "consumer:check": "node scripts/check-consumer.js",
    "inspect:stack": "node scripts/inspect-stack.js",
    "benchmark": "node scripts/benchmark.js",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release.js --check"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "eslint": "^10.9.1"
  },
  "dependencies": {
    "eslint-plugin-import-x": "^4.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
